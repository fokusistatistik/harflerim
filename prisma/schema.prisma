generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  firstName    String
  lastName     String
  tier         String   @default("basic")
  createdAt    DateTime @default(now())

  settings     UserSettings?
  sessions     Session[]
  authSessions AuthSession[]
}

/// Guardian-controlled settings. Reachable only through the parent gate.
model UserSettings {
  id       String @id @default(uuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  parentPin String @default("0000")

  dailyScreenLimit Int     @default(1800)
  reduceMotion     Boolean @default(false)
  highContrast     Boolean @default(false)
  speechEnabled    Boolean @default(true)
  cameraEnabled    Boolean @default(false)

  updatedAt DateTime @updatedAt
}

model AuthSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Session {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String    // Format: "YYYY-MM-DD"
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  // Analytics Aggregates
  totalDuration Int     @default(0) // Seconds
  levelReached  Int     @default(1) // 1 to 24
  gameId        String  @default("letter-hunt")

  events      Event[]

  @@unique([userId, date, gameId]) // One session per game per day
}

model Event {
  id           String   @id @default(uuid())
  sessionId    String
  session      Session  @relation(fields: [sessionId], references: [id])
  level        Int
  targetLetter String
  isCorrect    Boolean
  reactionTime Int      // Milliseconds
  createdAt    DateTime @default(now())
}
