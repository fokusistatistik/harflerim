generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String    @id @default(uuid()) // Matches Device ID cookie
  createdAt DateTime  @default(now())
  sessions  Session[]
}

model Session {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  date        String    // Format: "YYYY-MM-DD"
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  // Analytics Aggregates
  totalDuration Int     @default(0) // Seconds
  levelReached  Int     @default(1) // 1 to 24
  gameId        String  @default("letter-hunt")

  events      Event[]

  @@unique([userId, date, gameId]) // One session per game per day
}

model Event {
  id           String   @id @default(uuid())
  sessionId    String
  session      Session  @relation(fields: [sessionId], references: [id])
  level        Int
  targetLetter String
  isCorrect    Boolean
  reactionTime Int      // Milliseconds
  createdAt    DateTime @default(now())
}
