generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  firstName    String
  lastName     String
  avatarUrl    String? // 2026-09-13 — Genel sekmesinden yüklenir (mediaStorage.ts, "avatar" alt klasörü). Önceki hardcoded dead-CDN placeholder'ın yerini alır.
  tier         String   @default("basic")
  createdAt    DateTime @default(now())

  /// Faz 1.19 — yalnızca şema, henüz kullanılmıyor. Bkz. Guardian modelinin
  /// doc-comment'i.
  guardianId String?
  guardian   Guardian? @relation(fields: [guardianId], references: [id])

  settings      UserSettings?
  sessions      Session[]
  authSessions  AuthSession[]
  auditLogs     AuditLog[]
  dailyUsage    DailyUsage[]
  skillAttempts SkillAttempt[]
  familyMembers FamilyMember[]
  songs         Song[]
  videos        Video[]
  drawings      Drawing[]
  badges        Badge[]
}

/// Faz 2.2 — aile bireyleri kaydı. Yalnızca ebeveyn ekler/düzenler/siler;
/// çocuk hiçbir aile bilgisini giremez. Fotoğraf ve isteğe bağlı ses kaydı
/// yerel dosya sistemine yazılır (public/uploads/family), burada yalnızca
/// yol saklanır — bkz. src/lib/mediaStorage.ts. Hem Faz 2.5 (aile albümü
/// oyunu) hem Faz 3.3 (konuşmacı tanıma) bu tabloyu veri temeli olarak kullanır.
model FamilyMember {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  relation  String
  photoPath String
  voicePath String?
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Faz 2.3 — Müzik köşesi. Ebeveyn bir YouTube linki yapıştırır; başlık ve
/// kapak YouTube oEmbed uç noktasından (API anahtarı gerekmeden) çekilir
/// (bkz. src/lib/youtube.ts). `dailyLoopLimit` genel günlük ekran süresi
/// bütçesine (DailyUsage) EK, şarkı bazlı ayrıntılı bir sınırdır.
model Song {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  youtubeId      String
  title          String
  thumbnailUrl   String
  dailyLoopLimit Int      @default(3)
  createdAt      DateTime @default(now())

  playCounts SongPlayCount[]

  @@index([userId])
}

/// Bir şarkının bir gündeki çalınma sayısı — DailyUsage'ın şarkı bazlı
/// karşılığı, aynı "her satır bir gün" desenini izler.
model SongPlayCount {
  id        String @id @default(uuid())
  songId    String
  song      Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  date      String
  playCount Int    @default(0)

  @@unique([songId, date])
}

/// Faz 2.4 — "Melike'nin çizgi filmi" (kapsamı daraltılmış, bkz.
/// YOL-HARITASI.md 2.4 notu): gerçek yapay zekâ üretimi yok, ebeveynin
/// yüklediği hazır video/resimli hikâyeyi aynı kontrollü kabukta oynatan
/// bir kayıt. Dosya yerel dosya sistemine yazılır (bkz. mediaStorage.ts).
model Video {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  filePath  String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Faz 2.6 — çizim tahtası. Çocuğun çizdiği her tuval PNG olarak yerel
/// dosya sistemine kaydedilir (bkz. mediaStorage.ts) — ebeveyn için zaman
/// içindeki gelişimin görünür bir kaydı, bir başarı/puan ölçütü değil.
model Drawing {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filePath  String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Faz 2.8b — beceri rozetleri. Bir Skill (1.20 katmanı) bir kullanıcı için
/// ilk kez `isCorrect: true` ile tamamlandığında otomatik oluşturulur (bkz.
/// src/actions/skills.ts recordSkillAttempt). Emoji/label o anki Skill.label
/// ile denormalize edilip satıra gömülür — sabit ve öngörülebilir, PUAN/
/// SIRALAMA/SERİ DEĞİL (roadmap "Rozet var, rekabet yok" ilkesi).
model Badge {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  emoji     String
  label     String
  earnedAt  DateTime @default(now())

  @@unique([userId, skillId])
}

/// Faz 1.19 — "bir ebeveyn → çoklu çocuk" temeli (yalnızca şema, kullanılmıyor).
/// Yönetişim ilkesi: "User ile ebeveyn kimliği asla birebir eşlenmemelidir."
/// Şu an ebeveyn hiçbir veri varlığı değil — yalnızca çocuğun kendi
/// UserSettings.parentPin'i. Bu tablo, Faz 3.12 (kardeş profilleri) "tek bir
/// ebeveyn PIN'i tüm çocuk profillerini yönetir" gerekliliği için hazır
/// bekliyor. BİLİNÇLİ OLARAK mevcut parentPin/ParentGate/auth akışına
/// BAĞLANMADI — o akış UserSettings.parentPin üzerinden çalışmaya devam
/// ediyor. Kullanılmaya başlanması Faz 3.12'nin işi.
model Guardian {
  id        String   @id @default(uuid())
  /// bcrypt hash — Faz 3.12'de gerçek bir değerle doldurulacak, şimdilik boş.
  pinHash   String   @default("")
  createdAt DateTime @default(now())

  users User[]
}

/// Kim, ne zaman, ne yaptı kaydı. Loop-Kuralları md. "Her önemli işlem iz bırakır".
/// eventType değerleri src/lib/auditLog.ts'deki AuditEventType union'ı ile tip
/// güvenceli tutulur — SQLite Prisma'da native enum desteklemediği için burada
/// düz String olarak saklanır.
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventType String
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([eventType])
}

/// Guardian-controlled settings. Reachable only through the parent gate.
model UserSettings {
  id       String @id @default(uuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// bcrypt hash (Faz 1.3). Şema varsayılanı "0000" düz metindir yalnızca
  /// tip/NOT NULL güvencesi içindir — gerçek satırlar prisma/seed.ts ve
  /// src/actions/parentGate.ts tarafından her zaman hash'lenerek yazılır.
  /// Var olan düz metin satırları prisma/backfillParentPin.ts ile taşınır.
  parentPin String @default("0000")

  dailyScreenLimit Int     @default(1800)
  /// Harf Avı'nın günlük round (tur) limiti — süre bütçesine EK, ayrı bir
  /// sınır (2026-09-14, kullanıcı isteği). Diğer oyunları etkilemez.
  dailyLetterHuntLimit Int @default(100)
  /// Hafıza Kartları'nın günlük round (tur) limiti — dailyLetterHuntLimit ile
  /// aynı desen, ayrı bir sınır (2026-09-14, kullanıcı isteği, 10-50 arası,
  /// varsayılan 20). Diğer oyunları etkilemez.
  dailyMemoryMatchLimit Int @default(20)
  /// Gölge Eşleştirme'nin günlük round (tur) limiti — dailyMemoryMatchLimit ile
  /// aynı desen/aralık (2026-09-15, Faz 2.11 denetimi, 10-50 arası, varsayılan
  /// 20). Sayaç ayrı bir tabloya ihtiyaç duymaz — bugünkü SkillAttempt
  /// (gameId: "visual-match") sayısından hesaplanır (bkz. actions/gameProgress.ts).
  dailyVisualMatchLimit Int @default(20)
  reduceMotion     Boolean @default(false)
  highContrast     Boolean @default(false)
  speechEnabled    Boolean @default(true)
  cameraEnabled    Boolean @default(false)

  /// --- Çocuk profili (Faz 1.4b) ---
  /// Bir tanı aracı değildir, yalnızca kişiselleştirme verisidir (Klinik
  /// Sınır Sözleşmesi'ne tabi). Tüm alanlar opsiyoneldir. Henüz hiçbir UI'dan
  /// doldurulmuyor — Faz 2.1 ebeveyn yönetim paneli bekliyor.
  ///
  /// SQLite/Prisma dizi (String[]) veya native enum desteklemediği için
  /// (bkz. AuditLog.eventType gerekçesi) liste alanları JSON-string, sabit
  /// seçenekli alanlar ise düz String olarak saklanır; tip güvencesi
  /// src/lib/childProfile.ts'deki union tipler ve parse/serialize
  /// yardımcılarıyla uygulama katmanında sağlanır.
  age                Int?
  gender             String?
  favoriteColor      String?
  /// JSON string dizi, örn. '["kedi","gezegenler"]'
  interests          String?
  /// "reading" | "listening" | "visual"
  learningChannel    String?
  /// JSON obje, örn. '{"sound":"high","light":"low","touch":"medium"}'
  sensoryProfile     String?
  /// JSON string dizi
  triggers           String?
  /// JSON string dizi
  calmers            String?
  /// "verbal" | "aac" | "mixed"
  communicationLevel String?

  updatedAt DateTime @updatedAt
}

model AuthSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Session {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String    // Format: "YYYY-MM-DD"
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  // Analytics Aggregates
  totalDuration Int     @default(0) // Seconds
  levelReached  Int     @default(1) // 1 to 24
  gameId        String  @default("letter-hunt")
  /// 2026-09-14 — Hafıza Kartları'nın günlük round (tur) limiti için sayaç
  /// (bkz. UserSettings.dailyMemoryMatchLimit). Harf Avı bu amaçla `Event`
  /// tablosunu sayıyor (kendi ayrı Event modeli var); Hafıza Kartları'nın
  /// böyle bir tablosu olmadığı için burada doğrudan bir sayaç tutulur.
  /// Yalnızca `gameId: 'memory-match'` satırlarında anlamlıdır.
  roundsPlayed  Int     @default(0)

  events      Event[]

  @@unique([userId, date, gameId]) // One session per game per day
}

/// Oyun-bağımsız günlük toplam ekran süresi. `Session.totalDuration` her oyunun
/// kendi seansını izlerken, bu tablo tüm oyunlar genelindeki günlük toplamı
/// tutar ve `UserSettings.dailyScreenLimit`'e karşı denetlenir (Faz 1.17/1.10).
/// `completedAt` dolduğunda "gün tamamlandı" durumu oyundan bağımsız olarak
/// uygulama genelinde geçerli olur.
model DailyUsage {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         String // Format: "YYYY-MM-DD"
  totalSeconds Int       @default(0)
  completedAt  DateTime?

  @@unique([userId, date])
}

/// Harf grubu (Faz 1.4): `gameData.ts`'teki `LETTER_OBJECTS`/`LETTER_IMAGES`'ın
/// veritabanı karşılığı. Üç oyun da (Harf Avı, Hafıza Kartları, Sihirli
/// Kelimeler) aynı harf/kelime/görsel üçlüsünü kullandığı için tek bir şema
/// hepsini karşılar — ayrı oyun-bazlı içerik tablosuna gerek yok.
model ContentSet {
  id       String        @id @default(uuid())
  letter   String        @unique // "A", "B", "Ç", "İ" ... (Türkçe alfabe)
  order    Int // ALPHABET_ORDER'daki sıra
  imageUrl String // harf görseli (eski LETTER_IMAGES[letter])
  items    ContentItem[]

  @@index([order])
}

model ContentItem {
  id           String     @id @default(uuid())
  contentSetId String
  contentSet   ContentSet @relation(fields: [contentSetId], references: [id], onDelete: Cascade)
  word         String
  imageUrl     String
  order        Int // eski LETTER_OBJECTS[letter] dizisindeki sıra

  @@index([contentSetId])
}

model Event {
  id           String   @id @default(uuid())
  sessionId    String
  session      Session  @relation(fields: [sessionId], references: [id])
  level        Int
  targetLetter String
  isCorrect    Boolean
  reactionTime Int      // Milliseconds
  createdAt    DateTime @default(now())
}

/// Faz 1.20 — oyun-bağımsız beceri kataloğu. Faz 3.1'in "Beceri/kazanım
/// katmanı"nın erken temeli: dört oyun da kendi denemesini burada
/// tanımlanan bir beceriye karşı loglar (bkz. SkillAttempt). Zorluk
/// ayarlama mantığının kendisi hâlâ Faz 3.1/3.2'nin işi — burada yalnızca
/// ölçüm/kayıt var. `prisma/seedSkills.ts` ile tohumlanır.
model Skill {
  id    String @id @default(uuid())
  key   String @unique // "harf-tanima", "gorsel-hafiza", "sesli-kelime-tanima", "golge-eslestirme"
  label String

  attempts SkillAttempt[]
  badges   Badge[]
}

/// Her oyunun her denemesi (doğru/yanlış, tepki süresi varsa) buraya düşer.
/// GENEL-KURALLAR md.3'teki "istatistiksel veri temelli yaklaşım" ilkesinin
/// ve Faz 3.1 (uyarlanabilir zorluk)/3.8 (rapor)/2.8b (rozet) maddelerinin
/// dayanacağı ölçüm temeli.
model SkillAttempt {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId      String
  skill        Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  gameId       String // "letter-hunt" | "memory-match" | "magic-words" | "visual-match"
  isCorrect    Boolean
  reactionTime Int? // Milisaniye — her oyunda ölçülemeyebilir (ör. konuşma tanıma)
  hintsUsed    Int? // Faz 3.1 — yalnızca ipucu sistemi olan oyunlarda dolar (şu an yalnızca Harf Avı)
  createdAt    DateTime @default(now())

  @@index([userId, skillId])
}

/// 2026-09-13 — karşılaştırma/tanımlama oyunları için gerçek fotoğrafik
/// nesne kataloğu (kullanıcının "melike" klasöründeki 88 kare 888×888
/// görsel). ContentSet/ContentItem (harf-bazlı içerik) deseninden BİLİNÇLİ
/// OLARAK ayrı tutuldu — bu içerik bir harfe değil KATEGORİYE ve
/// KARŞILAŞTIRILABİLİR NİTELİKLERE (renk/ağırlık/hacim/boyut) bağlı,
/// "hangisi kırmızı", "hangisi daha ağır/büyük" gibi oyunlar için geniş
/// sütun yapısı bilinçli bir tasarım kararı (dar bir key-value tablosu
/// yerine — kullanıcının "uzun vadeli yönetilebilir geniş sütun yapısı"
/// isteği). `attributesJson`, henüz öngörülemeyen gelecekteki
/// karşılaştırma/tanım oyunları için şemayı migrate etmeden genişletmeye
/// yarayan bir kaçış kapısı. `prisma/seedComparisonItems.ts` ile tohumlanır.
model ComparisonItem {
  id       String @id @default(uuid())
  slug     String @unique // dosya adından türeyen sabit anahtar, örn "araba" — görsel dosya adı ve python okuma script'leriyle ortak
  name     String // ekranda gösterilecek Türkçe isim, örn "Araba"
  category String // ana kategori — bkz. seed script'teki sabit küme: hayvan | meyve-sebze | yiyecek | giyim | arac | esya | oyuncak | mobilya | gezegen-gokyuzu | doga

  color    String // baskın renk, Türkçe sabit bir küme (bkz. seed script) — örn "kırmızı"
  colorHex String? // yaklaşık hex kod — ileride görsel/otomatik renk analizinde doldurulabilir, v1'de boş

  approxWeightKg Float? // gerçek nesnenin yaklaşık ağırlığı (kg) — "hangisi daha ağır" oyunları için. Oyuncak olarak fotoğraflanmış nesnelerde OYUNCAK ölçeği, gerçek hayvan/meyve gibi nesnelerde GERÇEK DÜNYA ölçeği kullanıldı (bkz. seed script başındaki not) — karışık ölçek bilinçli bir ilk-sürüm kararı, gerekirse ayrıştırılabilir.
  approxVolumeL  Float? // yaklaşık hacim (litre) — kaba bir tahmin, özellikle katı/düzensiz şekilli nesnelerde (ağaç, at gibi) kesin değil
  approxSizeCm   Float? // gerçek nesnenin en uzun kenarı/boyu (cm) — ham "büyük/küçük" karşılaştırması için
  sizeCategory   String? // kucuk | orta | buyuk | kocaman — 6-7 yaş için ham cm/kg değerinden daha sezgisel, kaba bir karşılaştırma katmanı

  imageUrl    String // /karsilastirma/araba.jpg (public/karsilastirma altında, 888×888 kare)
  readingText String // Piper TTS okuma metni (bkz. papatyaPythonClient.ts) — v1'de `name` ile aynı, ileride farklılaşabilir (ör. "kırmızı araba")

  tags           String // virgülle ayrılmış serbest etiketler, esnek arama/filtre için — örn "hayvan,deniz,mavi,yüzen"
  attributesJson String? // gelecekteki karşılaştırma/tanım oyunları için JSON kaçış kapısı (bkz. yukarıdaki model notu)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([category])
}
