generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  firstName    String
  lastName     String
  tier         String   @default("basic")
  createdAt    DateTime @default(now())

  /// Faz 1.19 — yalnızca şema, henüz kullanılmıyor. Bkz. Guardian modelinin
  /// doc-comment'i.
  guardianId String?
  guardian   Guardian? @relation(fields: [guardianId], references: [id])

  settings      UserSettings?
  sessions      Session[]
  authSessions  AuthSession[]
  auditLogs     AuditLog[]
  dailyUsage    DailyUsage[]
  skillAttempts SkillAttempt[]
  familyMembers FamilyMember[]
  songs         Song[]
  videos        Video[]
}

/// Faz 2.2 — aile bireyleri kaydı. Yalnızca ebeveyn ekler/düzenler/siler;
/// çocuk hiçbir aile bilgisini giremez. Fotoğraf ve isteğe bağlı ses kaydı
/// yerel dosya sistemine yazılır (public/uploads/family), burada yalnızca
/// yol saklanır — bkz. src/lib/mediaStorage.ts. Hem Faz 2.5 (aile albümü
/// oyunu) hem Faz 3.3 (konuşmacı tanıma) bu tabloyu veri temeli olarak kullanır.
model FamilyMember {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  relation  String
  photoPath String
  voicePath String?
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Faz 2.3 — Müzik köşesi. Ebeveyn bir YouTube linki yapıştırır; başlık ve
/// kapak YouTube oEmbed uç noktasından (API anahtarı gerekmeden) çekilir
/// (bkz. src/lib/youtube.ts). `dailyLoopLimit` genel günlük ekran süresi
/// bütçesine (DailyUsage) EK, şarkı bazlı ayrıntılı bir sınırdır.
model Song {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  youtubeId      String
  title          String
  thumbnailUrl   String
  dailyLoopLimit Int      @default(3)
  createdAt      DateTime @default(now())

  playCounts SongPlayCount[]

  @@index([userId])
}

/// Bir şarkının bir gündeki çalınma sayısı — DailyUsage'ın şarkı bazlı
/// karşılığı, aynı "her satır bir gün" desenini izler.
model SongPlayCount {
  id        String @id @default(uuid())
  songId    String
  song      Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  date      String
  playCount Int    @default(0)

  @@unique([songId, date])
}

/// Faz 2.4 — "Melike'nin çizgi filmi" (kapsamı daraltılmış, bkz.
/// YOL-HARITASI.md 2.4 notu): gerçek yapay zekâ üretimi yok, ebeveynin
/// yüklediği hazır video/resimli hikâyeyi aynı kontrollü kabukta oynatan
/// bir kayıt. Dosya yerel dosya sistemine yazılır (bkz. mediaStorage.ts).
model Video {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  filePath  String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Faz 1.19 — "bir ebeveyn → çoklu çocuk" temeli (yalnızca şema, kullanılmıyor).
/// Yönetişim ilkesi: "User ile ebeveyn kimliği asla birebir eşlenmemelidir."
/// Şu an ebeveyn hiçbir veri varlığı değil — yalnızca çocuğun kendi
/// UserSettings.parentPin'i. Bu tablo, Faz 3.12 (kardeş profilleri) "tek bir
/// ebeveyn PIN'i tüm çocuk profillerini yönetir" gerekliliği için hazır
/// bekliyor. BİLİNÇLİ OLARAK mevcut parentPin/ParentGate/auth akışına
/// BAĞLANMADI — o akış UserSettings.parentPin üzerinden çalışmaya devam
/// ediyor. Kullanılmaya başlanması Faz 3.12'nin işi.
model Guardian {
  id        String   @id @default(uuid())
  /// bcrypt hash — Faz 3.12'de gerçek bir değerle doldurulacak, şimdilik boş.
  pinHash   String   @default("")
  createdAt DateTime @default(now())

  users User[]
}

/// Kim, ne zaman, ne yaptı kaydı. Loop-Kuralları md. "Her önemli işlem iz bırakır".
/// eventType değerleri src/lib/auditLog.ts'deki AuditEventType union'ı ile tip
/// güvenceli tutulur — SQLite Prisma'da native enum desteklemediği için burada
/// düz String olarak saklanır.
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventType String
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([eventType])
}

/// Guardian-controlled settings. Reachable only through the parent gate.
model UserSettings {
  id       String @id @default(uuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// bcrypt hash (Faz 1.3). Şema varsayılanı "0000" düz metindir yalnızca
  /// tip/NOT NULL güvencesi içindir — gerçek satırlar prisma/seed.ts ve
  /// src/actions/parentGate.ts tarafından her zaman hash'lenerek yazılır.
  /// Var olan düz metin satırları prisma/backfillParentPin.ts ile taşınır.
  parentPin String @default("0000")

  dailyScreenLimit Int     @default(1800)
  reduceMotion     Boolean @default(false)
  highContrast     Boolean @default(false)
  speechEnabled    Boolean @default(true)
  cameraEnabled    Boolean @default(false)

  /// --- Çocuk profili (Faz 1.4b) ---
  /// Bir tanı aracı değildir, yalnızca kişiselleştirme verisidir (Klinik
  /// Sınır Sözleşmesi'ne tabi). Tüm alanlar opsiyoneldir. Henüz hiçbir UI'dan
  /// doldurulmuyor — Faz 2.1 ebeveyn yönetim paneli bekliyor.
  ///
  /// SQLite/Prisma dizi (String[]) veya native enum desteklemediği için
  /// (bkz. AuditLog.eventType gerekçesi) liste alanları JSON-string, sabit
  /// seçenekli alanlar ise düz String olarak saklanır; tip güvencesi
  /// src/lib/childProfile.ts'deki union tipler ve parse/serialize
  /// yardımcılarıyla uygulama katmanında sağlanır.
  age                Int?
  gender             String?
  favoriteColor      String?
  /// JSON string dizi, örn. '["kedi","gezegenler"]'
  interests          String?
  /// "reading" | "listening" | "visual"
  learningChannel    String?
  /// JSON obje, örn. '{"sound":"high","light":"low","touch":"medium"}'
  sensoryProfile     String?
  /// JSON string dizi
  triggers           String?
  /// JSON string dizi
  calmers            String?
  /// "verbal" | "aac" | "mixed"
  communicationLevel String?

  updatedAt DateTime @updatedAt
}

model AuthSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Session {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String    // Format: "YYYY-MM-DD"
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  // Analytics Aggregates
  totalDuration Int     @default(0) // Seconds
  levelReached  Int     @default(1) // 1 to 24
  gameId        String  @default("letter-hunt")

  events      Event[]

  @@unique([userId, date, gameId]) // One session per game per day
}

/// Oyun-bağımsız günlük toplam ekran süresi. `Session.totalDuration` her oyunun
/// kendi seansını izlerken, bu tablo tüm oyunlar genelindeki günlük toplamı
/// tutar ve `UserSettings.dailyScreenLimit`'e karşı denetlenir (Faz 1.17/1.10).
/// `completedAt` dolduğunda "gün tamamlandı" durumu oyundan bağımsız olarak
/// uygulama genelinde geçerli olur.
model DailyUsage {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         String // Format: "YYYY-MM-DD"
  totalSeconds Int       @default(0)
  completedAt  DateTime?

  @@unique([userId, date])
}

/// Harf grubu (Faz 1.4): `gameData.ts`'teki `LETTER_OBJECTS`/`LETTER_IMAGES`'ın
/// veritabanı karşılığı. Üç oyun da (Harf Avı, Hafıza Kartları, Sihirli
/// Kelimeler) aynı harf/kelime/görsel üçlüsünü kullandığı için tek bir şema
/// hepsini karşılar — ayrı oyun-bazlı içerik tablosuna gerek yok.
model ContentSet {
  id       String        @id @default(uuid())
  letter   String        @unique // "A", "B", "Ç", "İ" ... (Türkçe alfabe)
  order    Int // ALPHABET_ORDER'daki sıra
  imageUrl String // harf görseli (eski LETTER_IMAGES[letter])
  items    ContentItem[]

  @@index([order])
}

model ContentItem {
  id           String     @id @default(uuid())
  contentSetId String
  contentSet   ContentSet @relation(fields: [contentSetId], references: [id], onDelete: Cascade)
  word         String
  imageUrl     String
  order        Int // eski LETTER_OBJECTS[letter] dizisindeki sıra

  @@index([contentSetId])
}

model Event {
  id           String   @id @default(uuid())
  sessionId    String
  session      Session  @relation(fields: [sessionId], references: [id])
  level        Int
  targetLetter String
  isCorrect    Boolean
  reactionTime Int      // Milliseconds
  createdAt    DateTime @default(now())
}

/// Faz 1.20 — oyun-bağımsız beceri kataloğu. Faz 3.1'in "Beceri/kazanım
/// katmanı"nın erken temeli: dört oyun da kendi denemesini burada
/// tanımlanan bir beceriye karşı loglar (bkz. SkillAttempt). Zorluk
/// ayarlama mantığının kendisi hâlâ Faz 3.1/3.2'nin işi — burada yalnızca
/// ölçüm/kayıt var. `prisma/seedSkills.ts` ile tohumlanır.
model Skill {
  id    String @id @default(uuid())
  key   String @unique // "harf-tanima", "gorsel-hafiza", "sesli-kelime-tanima", "golge-eslestirme"
  label String

  attempts SkillAttempt[]
}

/// Her oyunun her denemesi (doğru/yanlış, tepki süresi varsa) buraya düşer.
/// GENEL-KURALLAR md.3'teki "istatistiksel veri temelli yaklaşım" ilkesinin
/// ve Faz 3.1 (uyarlanabilir zorluk)/3.8 (rapor)/2.8b (rozet) maddelerinin
/// dayanacağı ölçüm temeli.
model SkillAttempt {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId      String
  skill        Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  gameId       String // "letter-hunt" | "memory-match" | "magic-words" | "visual-match"
  isCorrect    Boolean
  reactionTime Int? // Milisaniye — her oyunda ölçülemeyebilir (ör. konuşma tanıma)
  createdAt    DateTime @default(now())

  @@index([userId, skillId])
}
