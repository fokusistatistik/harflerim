# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local database backups
prisma/*.db.backup-*
prisma/*.db.oldschema

# SQLite transient files (never meaningful to commit)
prisma/*.db-journal
shadow.db

# next-pwa service worker output (Faz 1.11) — regenerated by every
# production build (`npm run build`); committing it just churns the diff
# and can go stale relative to next.config.js's actual runtimeCaching rules.
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/swe-worker-*.js
public/fallback-*.js

# Ebeveynin yüklediği aile fotoğrafı/ses kaydı/çizim gibi kişisel medya
# (Faz 2.2+) — katı yerel işleme ilkesi gereği repoya asla girmez.
public/uploads/*
!public/uploads/.gitkeep

# Python (python/ — Faz 3 Python temel altyapısı)
python/__pycache__/
python/**/__pycache__/
python/venv/
python/.venv/
python/.pytest_cache/

# Faz 3.5 — Piper TTS ağırlıkları (Docker build sırasında indirilir, ~63MB,
# git'e asla commit edilmez) + üretilen ses önbelleği.
python/tts_models/
python/cache/

# Faz 3.3 — konuşmacı embedding'leri (aile bireylerinin ses parmak izi
# vektörleri) — kişisel veri, katı yerel işleme ilkesi gereği repoya girmez.
python/speaker_embeddings/
