# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local database backups
prisma/*.db.backup-*
prisma/*.db.oldschema

# SQLite transient files (never meaningful to commit)
prisma/*.db-journal
shadow.db

# next-pwa service worker output (Faz 1.11) — regenerated by every
# production build (`npm run build`); committing it just churns the diff
# and can go stale relative to next.config.js's actual runtimeCaching rules.
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/swe-worker-*.js
public/fallback-*.js
